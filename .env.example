# Railway provides this automatically when you add a Postgres plugin --
# copy it from the Railway dashboard (Postgres service -> Variables ->
# DATABASE_URL). When you later move to Azure, this is the ONLY line
# that changes: swap it for the Azure connection string and everything
# else in this app is untouched.
DATABASE_URL=postgresql://user:password@host:5432/takmildb

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

PORT=3000
